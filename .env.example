POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
POSTGRES_DB=rental
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-me-please-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=false

# Токен бота от @BotFather. Пусто — уведомления выключены
TELEGRAM_BOT_TOKEN=
TIMEZONE=Europe/Moscow
SITE_URL=http://localhost:5173

# Ключ «API Геокодера» Яндекса для подсказок адресов. Пусто — адрес вводится свободным текстом
YANDEX_GEOCODER_API_KEY=

# 152-ФЗ: true — при регистрации нужна галочка согласия, в подвале ссылка на политику.
# Пока сайт только для своих, можно оставить false
PRIVACY_CONSENT_REQUIRED=false
# Оператор персональных данных (152-ФЗ): показывается на странице /privacy
OPERATOR_NAME=
OPERATOR_EMAIL=

# Почта для восстановления пароля (необязательно). Подойдёт ящик Яндекс 360 или Mail.ru
# с паролем приложения: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
