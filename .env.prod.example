# Скопируйте в .env.prod и заполните. Файл .env.prod в Git не попадает.

# Адрес сайта для Caddy: ":80" — запуск на своём компьютере (http://localhost),
# доменное имя — на сервере, например kovsh.example.ru (HTTPS настроится сам)
SITE_ADDRESS=:80
# Полный адрес сайта для ссылок в Telegram-уведомлениях
SITE_URL=http://localhost

POSTGRES_USER=rental
POSTGRES_PASSWORD=смените-на-длинный-пароль
POSTGRES_DB=rental

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# true, когда сайт работает по HTTPS
COOKIE_SECURE=false

TELEGRAM_BOT_TOKEN=
# Ключ «API Геокодера» Яндекса (отдельный от ключа карт): подсказки и проверка адресов
YANDEX_GEOCODER_API_KEY=
TIMEZONE=Europe/Moscow

# Ключ JavaScript API Яндекс Карт. В ограничения ключа добавьте домен сайта
VITE_YANDEX_MAPS_API_KEY=

# 152-ФЗ: true — при регистрации нужна галочка согласия, в подвале ссылка на политику.
# Пока сайт только для своих, можно оставить false
PRIVACY_CONSENT_REQUIRED=false
# Оператор персональных данных (152-ФЗ): показывается на странице /privacy
OPERATOR_NAME=
OPERATOR_EMAIL=

# Почта для восстановления пароля (необязательно). Подойдёт ящик Яндекс 360 или Mail.ru
# с паролем приложения: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Мониторинг: отдельный бот, который пишет вам об ошибках на сервере и перезапусках.
# ALERT_CHAT_ID — ваш chat id (из https://api.telegram.org/bot<ТОКЕН>/getUpdates)
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
