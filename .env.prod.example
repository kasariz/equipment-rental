# Скопируйте в .env.prod и заполните. Файл .env.prod в Git не попадает.

# Адрес сайта для Caddy: ":80" — запуск на своём компьютере (http://localhost),
# доменное имя — на сервере, например kovsh.example.ru (HTTPS настроится сам)
SITE_ADDRESS=:80
# Полный адрес сайта для ссылок в Telegram-уведомлениях
SITE_URL=http://localhost

POSTGRES_USER=rental
POSTGRES_PASSWORD=смените-на-длинный-пароль
POSTGRES_DB=rental

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# true, когда сайт работает по HTTPS
COOKIE_SECURE=false

TELEGRAM_BOT_TOKEN=
# Ключ «API Геокодера» Яндекса (отдельный от ключа карт): подсказки и проверка адресов
YANDEX_GEOCODER_API_KEY=
TIMEZONE=Europe/Moscow

# Ключ JavaScript API Яндекс Карт. В ограничения ключа добавьте домен сайта
VITE_YANDEX_MAPS_API_KEY=
